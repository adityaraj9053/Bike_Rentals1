# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=bike

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins (Comma-separated)
CLIENT_ORIGIN=https://bikeagle.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006

# Cloudinary Image Upload Service
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudflare R2 Storage (Confidential User & Vehicle Documents)
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_cloudflare_r2_bucket_name

# Owner Admin Email
OWNER_EMAIL=gamedevelop06@gmail.com

# ---------------------------------------------------------------------------
# Email Delivery Configuration (OTP & Notifications)
# ---------------------------------------------------------------------------
# FOR HOSTED CLOUD (Render/Vercel/Railway):
# Cloud hosts (e.g. Render Free Tier) BLOCK outbound SMTP ports (25, 465, 587).
# You MUST provide an API key for Brevo (recommended free 300/day) or Resend (Port 443 HTTPS REST API).
# Option A: Brevo (Recommended for free tier - no custom domain required)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=gamedevelop06@gmail.com

# Option B: Resend
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=The Road Eagle <onboarding@resend.dev>

# FOR LOCALHOST (Fallback Nodemailer Gmail SMTP):
MAIL_HOST=smtp.gmail.com
MAIL_USER=testshuklaweb@gmail.com
MAIL_PASS=your_gmail_app_password
